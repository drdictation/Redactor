/*
 * Vercel configuration for the RedactPDF Auditor subdomain
 * Maps any request to audit.redactpdf.app to the /auditor route
 * while keeping the main domain pointing to the root.
 */
{
    "rewrites": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "audit.redactpdf.app"
                }
            ],
            "destination": "/auditor/:path*"
        }
    ]
}